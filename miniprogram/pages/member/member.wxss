.member-page { padding-bottom: 48rpx; }
.member-head { padding: 0 var(--pad-page); }

/* 周期切换：周 / 月 / 年。个人页不做日视图——三项指标是周均口径，单日算不出平均 */
.period-row { display: flex; align-items: center; gap: 12rpx; padding: 24rpx var(--pad-page) 0; }
.chip { padding: 0 24rpx; line-height: 54rpx; border: 1rpx solid transparent; border-radius: 999rpx; background: #f5f5f6; font-size: var(--fs-caption); color: var(--ink-4); }
.chip-on { background: #fff; border-color: var(--ink-7); color: var(--ink-1); font-weight: 600; }
.period-range { margin-left: auto; font-size: var(--fs-caption); color: var(--ink-5); }

/* 顶部五张卡：数字在上、名字在中、口径在最下 */
.stat-grid { display: flex; margin: 24rpx var(--pad-page) 0; padding: 20rpx 8rpx; background: #fff; border-radius: 32rpx; }
.stat-cell { flex: 1; text-align: center; padding: 0 4rpx; }
.stat-value { font-size: var(--fs-subhead); color: var(--ink-1); font-weight: 600; line-height: 46rpx; font-variant-numeric: tabular-nums; }
.stat-unit { font-size: var(--fs-micro); color: var(--ink-5); font-weight: 400; }
.stat-label { font-size: var(--fs-micro); color: var(--ink-3); line-height: 32rpx; }
.stat-sub { font-size: var(--fs-micro); color: var(--ink-5); line-height: 28rpx; }

.metric-tabs { display: flex; gap: 12rpx; padding: 24rpx var(--pad-page) 0; }
.metric-tab { padding: 0 20rpx; line-height: 48rpx; border: 1rpx solid transparent; border-radius: 999rpx; background: #f5f5f6; font-size: var(--fs-caption); color: var(--ink-4); }
.metric-tab-on { background: #fff; border-color: var(--ink-7); color: var(--ink-1); font-weight: 600; }

.banner { height: 780rpx; margin-top: 20rpx; }
.banner-card { height: 740rpx; margin: 0 var(--pad-page); padding: 24rpx 24rpx 0; box-sizing: border-box; background: #fff; border-radius: 32rpx; }
.banner-head { display: flex; align-items: baseline; }
.banner-title { font-size: var(--fs-body); color: var(--ink-1); font-weight: 600; }
.banner-unit { margin-left: auto; font-size: var(--fs-micro); color: var(--ink-5); }
.banner-range { font-size: var(--fs-micro); color: var(--ink-4); margin-top: 4rpx; }

/* 柱状图：高度由数据算好写在 style 里，这里只管容器。
   目标虚线画在柱区上沿 150% 的 100/150 处，柱子高过它就是喝超了 */
.bar-plot { position: relative; display: flex; align-items: flex-end; gap: 6rpx; height: 200rpx; margin-top: 20rpx; }
.bar-goal { position: absolute; left: 0; right: 0; height: 0; border-top: 3rpx dashed #06B6D4; }
.bar-col { position: relative; flex: 1; height: 100%; display: flex; align-items: flex-end; }
.bar-fill { width: 100%; border-radius: 6rpx 6rpx 0 0; }
.dot-stem { position: absolute; left: 50%; bottom: 0; width: 2rpx; margin-left: -1rpx; background: var(--ink-7); }
.dot-node { position: absolute; left: 50%; width: 16rpx; height: 16rpx; margin-left: -8rpx; margin-bottom: -8rpx; border-radius: 50%; background: #32A964; }
.bar-axis { display: flex; gap: 6rpx; margin-top: 8rpx; }
.bar-x { flex: 1; min-height: 26rpx; text-align: center; font-size: var(--fs-micro); color: var(--ink-5); }

.banner-hint { font-size: var(--fs-micro); color: var(--ink-6); margin-top: 12rpx; line-height: 30rpx; }

.day-list { height: 320rpx; margin-top: 12rpx; }
.day-row { display: flex; align-items: center; justify-content: space-between; padding: 14rpx 0; border-top: 1rpx solid #f0f0f1; }
.day-row-date { font-size: var(--fs-caption); color: var(--ink-3); }
.day-row-text { font-size: var(--fs-caption); color: var(--ink-1); font-variant-numeric: tabular-nums; }

.board-note { display: block; padding: 0 var(--pad-page); margin-top: 20rpx; }

/* 抗阻强度分布一行（2026-10-30）：低/中/高各几次 */
.si-line { margin: 16rpx var(--pad-page) 0; padding: 18rpx 28rpx; background: #fff; border-radius: 20rpx; font-size: var(--fs-caption); color: var(--ink-3); font-variant-numeric: tabular-nums; }
