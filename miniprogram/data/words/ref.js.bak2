  {"w":"bones","ipa":"/bəʊnz/","pos":"n.","zh":"骨头（复数）","say":"Strong bones matter as you age.","sayZh":"上了年纪，骨骼强壮很重要。","ex":"Cartilage covers the ends of bones.","exZh":"软骨盖在骨头末端。","cat":"anatomy","ref":true},
  {"w":"nerve","ipa":"/nɜːv/","pos":"n.","zh":"神经","say":"A pinched nerve can cause pain down the leg.","sayZh":"神经受压会引起腿部的放射痛。","ex":"The nerve sends signals to the muscle.","exZh":"神经把信号传给肌肉。","cat":"anatomy","ref":true},
  {"w":"nerves","ipa":"/nɜːvz/","pos":"n.","zh":"神经（复数）","say":"Protect the nerves around the neck.","sayZh":"保护好脖子附近的神经。","ex":"Nerves carry signals from the brain.","exZh":"神经把大脑的信号传出去。","cat":"anatomy","ref":true},
  {"w":"toe","ipa":"/təʊ/","pos":"n.","zh":"脚趾","say":"Push off from your big toe.","sayZh":"用大脚趾蹬地发力。","ex":"Keep the toe down during the lift.","exZh":"举起时脚趾踩稳。","cat":"anatomy","ref":true},
  {"w":"toes","ipa":"/təʊz/","pos":"n.","zh":"脚趾（复数）","say":"Spread your toes for better balance.","sayZh":"张开脚趾站得更稳。","ex":"Keep the patella over your toes.","exZh":"让髌骨对着脚趾方向。","cat":"anatomy","ref":true},
  {"w":"heel","ipa":"/hiːl/","pos":"n.","zh":"脚后跟","say":"Land softly on your heel.","sayZh":"脚后跟轻轻落地。","ex":"The plantar fascia runs from heel to ball.","exZh":"足底筋膜从脚跟连到脚掌。","cat":"anatomy","ref":true},
  {"w":"kneecap","ipa":"/ˈniːkæp/","pos":"n.","zh":"髌骨；膝盖骨","say":"Keep the kneecap tracking over the toes.","sayZh":"让髌骨对着脚趾方向。","ex":"Pain around the kneecap often starts at the hip.","exZh":"膝盖骨周围的痛常源于髋部。","cat":"anatomy","ref":true},
  {"w":"shin","ipa":"/ʃɪn/","pos":"n.","zh":"胫骨；小腿前侧","say":"Keep the bar close to your shins.","sayZh":"杠铃贴近小腿前侧。","ex":"The patellar tendon links the kneecap to the shin.","exZh":"髌腱把髌骨连到胫骨。","cat":"anatomy","ref":true},
  {"w":"blade","ipa":"/bleɪd/","pos":"n.","zh":"肩胛（shoulder blade）","say":"Pull the shoulder blade down and in.","sayZh":"肩胛骨向下向内收。","ex":"The serratus holds the blade to the rib cage.","exZh":"前锯肌把肩胛固定到肋骨。","cat":"anatomy","ref":true},
  {"w":"arch","ipa":"/ɑːtʃ/","pos":"n.","zh":"足弓；拱","say":"Lift the arch as you push off.","sayZh":"蹬地时抬起足弓。","ex":"Toe extension raises the arch.","exZh":"脚趾伸展会抬高足弓。","cat":"anatomy","ref":true},
  {"w":"belly","ipa":"/ˈbeli/","pos":"n.","zh":"腹部","say":"Row the weight to your belly.","sayZh":"把重量拉到腹部。","ex":"Brace your belly before you lift.","exZh":"举起前收紧腹部。","cat":"anatomy","ref":true},
  {"w":"limb","ipa":"/lɪm/","pos":"n.","zh":"肢体","say":"Move the whole limb together.","sayZh":"整条肢体一起动。","ex":"A limb is an arm or a leg.","exZh":"肢体指手臂或腿。","cat":"anatomy","ref":true},
  {"w":"limbs","ipa":"/lɪmz/","pos":"n.","zh":"肢体（复数）","say":"Warm up both limbs evenly.","sayZh":"两条肢体均匀热身。","ex":"Strong limbs make daily life easier.","exZh":"肢体有力，日常更轻松。","cat":"anatomy","ref":true},
  {"w":"torso","ipa":"/ˈtɔːsəʊ/","pos":"n.","zh":"躯干","say":"Keep the torso steady through the move.","sayZh":"动作中保持躯干稳定。","ex":"The torso carries the head and trunk.","exZh":"躯干承载头和上身。","cat":"anatomy","ref":true},
  {"w":"abdomen","ipa":"/æbˈdəʊmən/","pos":"n.","zh":"腹部","say":"Brace the abdomen before lifting.","sayZh":"举起前收紧腹部。","ex":"The abdomen holds the core muscles.","exZh":"腹部包着核心肌群。","cat":"anatomy","ref":true},
  {"w":"breastbone","ipa":"/ˈbrestbəʊn/","pos":"n.","zh":"胸骨","say":"Keep the bar over the breastbone.","sayZh":"杠铃保持在胸骨上方。","ex":"The clavicle meets the breastbone.","exZh":"锁骨与胸骨相连。","cat":"anatomy","ref":true},
  {"w":"vertebrae","ipa":"/ˈvɜːtɪbriː/","pos":"n.","zh":"椎骨","say":"The spine has thirty-three vertebrae.","sayZh":"脊柱有三十三块椎骨。","ex":"Discs sit between the vertebrae.","exZh":"椎间盘位于椎骨之间。","cat":"anatomy","ref":true},
  {"w":"disc","ipa":"/dɪsk/","pos":"n.","zh":"椎间盘","say":"A disc can bulge under load.","sayZh":"椎间盘在负重下可能膨出。","ex":"Discs sit between the vertebrae.","exZh":"椎间盘位于椎骨之间。","cat":"anatomy","ref":true},
  {"w":"spinal","ipa":"/ˈspaɪnl/","pos":"adj.","zh":"脊柱的","say":"Keep a neutral spinal position.","sayZh":"保持脊柱中立位。","ex":"The spinal muscles support the back.","exZh":"脊柱肌群支撑后背。","cat":"anatomy","ref":true},
  {"w":"fibre","ipa":"/ˈfaɪbə/","pos":"n.","zh":"纤维（肌纤维/膳食）","say":"Slow fibres last longer.","sayZh":"慢肌纤维更耐久。","ex":"Fibre carries signals inside the muscle.","exZh":"纤维在肌肉内部传导信号。","cat":"anatomy","ref":true},
  {"w":"fibres","ipa":"/ˈfaɪbəz/","pos":"n.","zh":"纤维（复数）","say":"Mix slow and fast fibres.","sayZh":"慢肌和快肌纤维混合。","ex":"Muscle is made of many fibres.","exZh":"肌肉由许多纤维组成。","cat":"anatomy","ref":true},
  {"w":"menisci","ipa":"/məˈnɪskaɪ/","pos":"n.","zh":"半月板（复数）","say":"Menisci cushion the knee.","sayZh":"半月板缓冲膝关节。","ex":"Menisci sit between the thigh and shin.","exZh":"半月板在股骨和胫骨之间。","cat":"anatomy","ref":true},
  {"w":"achilles","ipa":"/əˈkɪliːz/","pos":"n.","zh":"跟腱（Achilles）","say":"Warm up the achilles before sprints.","sayZh":"冲刺前先热身跟腱。","ex":"The achilles links calf to heel.","exZh":"跟腱连接小腿肚和脚跟。","cat":"anatomy","ref":true},
  {"w":"medial","ipa":"/ˈmiːdiəl/","pos":"adj.","zh":"内侧的","say":"The medial head works here.","sayZh":"内侧头在这里发力。","ex":"The medial collateral ligament is on the inner knee.","exZh":"内侧副韧带在膝盖内侧。","cat":"anatomy","ref":true},
  {"w":"lateral","ipa":"/ˈlætərəl/","pos":"adj.","zh":"外侧的","say":"Train the lateral side too.","sayZh":"外侧也要练到。","ex":"The lateral ligament is on the outer knee.","exZh":"外侧韧带在膝盖外侧。","cat":"anatomy","ref":true},
  {"w":"sole","ipa":"/səʊl/","pos":"n.","zh":"脚底； sole","say":"Feel the whole sole on the floor.","sayZh":"脚底整个踩实地面。","ex":"The sole is the bottom of the foot.","exZh":"脚底是脚的底部。","cat":"anatomy","ref":true},
  {"w":"quad","ipa":"/kwɒd/","pos":"n.","zh":"股四头肌（口语）","say":"Squeeze the quad at the top.","sayZh":"顶端夹紧股四头。","ex":"The quad straightens the knee.","exZh":"股四头伸直膝关节。","cat":"anatomy","ref":true},
  {"w":"delts","ipa":"/delts/","pos":"n.","zh":"三角肌（口语）","say":"Press works the delts hard.","sayZh":"推举狠练三角肌。","ex":"The delts shape the shoulder.","exZh":"三角肌决定肩膀外形。","cat":"anatomy","ref":true},
  {"w":"lats","ipa":"/læts/","pos":"n.","zh":"背阔肌（口语）","say":"Pull with the lats, not the arms.","sayZh":"用背阔肌拉，不是手臂。","ex":"The lats widen the back.","exZh":"背阔肌把背拉宽。","cat":"anatomy","ref":true},
  {"w":"biceps","ipa":"/ˈbaɪseps/","pos":"n.","zh":"二头肌","say":"Curl the biceps slowly.","sayZh":"慢慢弯举二头肌。","ex":"The biceps bends the elbow.","exZh":"二头肌屈肘。","cat":"anatomy","ref":true},
  {"w":"abs","ipa":"/æbz/","pos":"n.","zh":"腹肌（口语）","say":"Brace the abs before the press.","sayZh":"推举前收紧腹肌。","ex":"The abs stabilise the spine.","exZh":"腹肌稳定脊柱。","cat":"anatomy","ref":true},
  {"w":"bony","ipa":"/ˈbəʊni/","pos":"adj.","zh":"骨的；骨质的","say":"Feel the bony point on top.","sayZh":"摸到顶上的骨性突起。","ex":"The acromion is a bony tip.","exZh":"肩峰是一处骨性尖端。","cat":"anatomy","ref":true},
  {"w":"ring","ipa":"/rɪŋ/","pos":"n.","zh":"环；圈","say":"A ring of cartilage deepens the socket.","sayZh":"一圈软骨加深关节窝。","ex":"The labrum is a ring of cartilage.","exZh":"盂唇是一圈软骨。","cat":"anatomy","ref":true},
  {"w":"gap","ipa":"/ɡæp/","pos":"n.","zh":"间隙；缺口","say":"Keep a small gap between bones.","sayZh":"骨头之间留一点间隙。","ex":"Joint space is the gap on a scan.","exZh":"关节间隙就是片子上骨间的缝。","cat":"anatomy","ref":true},
  {"w":"edge","ipa":"/edʒ/","pos":"n.","zh":"边缘","say":"Stop at the edge of the range.","sayZh":"到幅度边缘就停。","ex":"An osteophyte grows at the edge of a joint.","exZh":"骨刺长在关节边缘。","cat":"anatomy","ref":true},
  {"w":"inward","ipa":"/ˈɪnwəd/","pos":"adv./adj.","zh":"向内","say":"Roll the shoulder inward slightly.","sayZh":"肩膀稍微向内收。","ex":"The adductor pulls the leg inward.","exZh":"内收肌把腿向内拉。","cat":"anatomy","ref":true},
  {"w":"outward","ipa":"/ˈaʊtwəd/","pos":"adv./adj.","zh":"向外","say":"Turn the arm outward.","sayZh":"手臂向外转。","ex":"The rotator turns the arm outward.","exZh":"肩袖让手臂向外转。","cat":"anatomy","ref":true},
  {"w":"inner","ipa":"/ˈɪnə/","pos":"adj.","zh":"内部的","say":"Feel the inner thigh work.","sayZh":"感受大腿内侧发力。","ex":"The inner thigh is the adductor.","exZh":"大腿内侧是内收肌。","cat":"anatomy","ref":true},
  {"w":"energy","ipa":"/ˈenədʒi/","pos":"n.","zh":"能量","say":"Food gives you energy for training.","sayZh":"食物给你训练的能量。","ex":"Running economy is the energy cost of running.","exZh":"跑步经济性就是跑动消耗的能量。","cat":"nutrition","ref":true},
  {"w":"vegetables","ipa":"/ˈvedʒtəbəlz/","pos":"n.","zh":"蔬菜（复数）","say":"Eat vegetables with every meal.","sayZh":"每餐都吃蔬菜。","ex":"Vegetables bring micronutrients.","exZh":"蔬菜提供微量营养素。","cat":"nutrition","ref":true},
  {"w":"vegetable","ipa":"/ˈvedʒtəbəl/","pos":"n.","zh":"蔬菜","say":"Add one vegetable to the plate.","sayZh":"盘里加一样蔬菜。","ex":"Whole grains and vegetable skins carry fibre.","exZh":"全谷和菜皮含有纤维。","cat":"nutrition","ref":true},
  {"w":"vitamin","ipa":"/ˈvɪtəmɪn/","pos":"n.","zh":"维生素","say":"Vitamin D comes from the sun.","sayZh":"维生素 D 来自阳光。","ex":"Vitamin B12 comes from animal foods.","exZh":"维生素 B12 来自动物性食物。","cat":"nutrition","ref":true},
  {"w":"vitamins","ipa":"/ˈvɪtəmɪnz/","pos":"n.","zh":"维生素（复数）","say":"Fat helps you absorb vitamins.","sayZh":"脂肪帮你吸收维生素。","ex":"Vegetables cover most vitamins.","exZh":"蔬菜覆盖大部分维生素。","cat":"nutrition","ref":true},
  {"w":"oil","ipa":"/ɔɪl/","pos":"n.","zh":"油","say":"Cook with a little oil.","sayZh":"放一点油来炒。","ex":"Olive oil is mostly unsaturated fat.","exZh":"橄榄油主要是不饱和脂肪。","cat":"nutrition","ref":true},
  {"w":"oils","ipa":"/ɔɪlz/","pos":"n.","zh":"油（复数）","say":"Different oils suit different heats.","sayZh":"不同油适合不同火候。","ex":"MCT oil goes straight to the liver.","exZh":"MCT 油直接进肝脏。","cat":"nutrition","ref":true},
  {"w":"salt","ipa":"/sɔːlt/","pos":"n.","zh":"盐","say":"Add a little salt after training.","sayZh":"训练后补一点盐。","ex":"Sweat carries salt out of the body.","exZh":"汗水把盐带出体外。","cat":"nutrition","ref":true},
  {"w":"dairy","ipa":"/ˈdeəri/","pos":"n.","zh":"乳制品","say":"Whey is fine if dairy sits well.","sayZh":"肠胃耐受乳制品的话，乳清没问题。","ex":"Dairy brings calcium and protein.","exZh":"乳制品提供钙和蛋白质。","cat":"nutrition","ref":true},
  {"w":"nuts","ipa":"/nʌts/","pos":"n.","zh":"坚果（复数）","say":"A handful of nuts is a good snack.","sayZh":"一把坚果是不错的加餐。","ex":"Nuts are sources of unsaturated fat.","exZh":"坚果是不饱和脂肪的来源。","cat":"nutrition","ref":true},
  {"w":"nut","ipa":"/nʌt/","pos":"n.","zh":"坚果","say":"One nut or two is enough.","sayZh":"一两颗坚果就够了。","ex":"A nut is a small oily seed.","exZh":"坚果是一种含油的小种子。","cat":"nutrition","ref":true},
  {"w":"eggs","ipa":"/eɡz/","pos":"n.","zh":"鸡蛋（复数）","say":"Eggs are cheap protein.","sayZh":"鸡蛋是便宜的蛋白质。","ex":"Eggs are rich in leucine.","exZh":"鸡蛋富含亮氨酸。","cat":"nutrition","ref":true},
  {"w":"egg","ipa":"/eɡ/","pos":"n.","zh":"鸡蛋","say":"One egg has about six grams of protein.","sayZh":"一个鸡蛋约六克蛋白质。","ex":"An egg is a complete protein.","exZh":"鸡蛋是完整蛋白。","cat":"nutrition","ref":true},
  {"w":"diet","ipa":"/ˈdaɪət/","pos":"n.","zh":"饮食","say":"Keep some fat in your diet.","sayZh":"饮食里留点脂肪。","ex":"Flexible dieting hits your numbers.","exZh":"弹性饮食能压住你的指标。","cat":"nutrition","ref":true},
  {"w":"diets","ipa":"/ˈdaɪəts/","pos":"n.","zh":"饮食（复数）","say":"Most diets fail by being too strict.","sayZh":"多数饮食法败在太严苛。","ex":"Low-carb diets cut the sugar source.","exZh":"低碳饮食砍掉糖的来源。","cat":"nutrition","ref":true},
  {"w":"cooking","ipa":"/ˈkʊkɪŋ/","pos":"n.","zh":"烹饪","say":"Cooking at home gives you control.","sayZh":"在家做饭你能掌控。","ex":"Cooking often improves protein digestibility.","exZh":"烹饪常能提升蛋白质消化率。","cat":"nutrition","ref":true},
  {"w":"beans","ipa":"/biːnz/","pos":"n.","zh":"豆类（复数）","say":"Beans are cheap protein.","sayZh":"豆类是便宜的蛋白质。","ex":"Pairing grains with beans fixes the lysine gap.","exZh":"谷物配豆类补上赖氨酸缺口。","cat":"nutrition","ref":true},
  {"w":"grains","ipa":"/ɡreɪnz/","pos":"n.","zh":"谷物（复数）","say":"Whole grains keep you full.","sayZh":"全谷物更扛饿。","ex":"Grains pair with beans for complete protein.","exZh":"谷物配豆类得到完整蛋白。","cat":"nutrition","ref":true},
  {"w":"grain","ipa":"/ɡreɪn/","pos":"n.","zh":"谷物","say":"Choose a whole grain.","sayZh":"选全谷物。","ex":"A grain is a small hard seed.","exZh":"谷物是细小坚硬的种子。","cat":"nutrition","ref":true},
  {"w":"gut","ipa":"/ɡʌt/","pos":"n.","zh":"肠道","say":"Feed your gut with fibre.","sayZh":"用纤维喂养肠道。","ex":"Threonine supports the gut lining.","exZh":"苏氨酸支持肠道黏膜。","cat":"nutrition","ref":true},
  {"w":"nutrient","ipa":"/ˈnjuːtriənt/","pos":"n.","zh":"营养素","say":"Each meal needs a nutrient.","sayZh":"每餐都要有营养素。","ex":"A nutrient is something the body uses.","exZh":"营养素是身体会利用的东西。","cat":"nutrition","ref":true},
  {"w":"nutrients","ipa":"/ˈnjuːtriənts/","pos":"n.","zh":"营养素（复数）","say":"Vegetables bring many nutrients.","sayZh":"蔬菜带来多种营养素。","ex":"Synovial fluid feeds the cartilage with nutrients.","exZh":"滑液把营养素送进软骨。","cat":"nutrition","ref":true},
  {"w":"bacteria","ipa":"/bækˈtɪəriə/","pos":"n.","zh":"细菌","say":"Good bacteria live in the gut.","sayZh":"有益细菌住在肠道里。","ex":"Resistant starch feeds your gut bacteria.","exZh":"抗性淀粉喂养肠道细菌。","cat":"nutrition","ref":true},
  {"w":"cells","ipa":"/selz/","pos":"n.","zh":"细胞（复数）","say":"Insulin moves sugar into cells.","sayZh":"胰岛素把糖送进细胞。","ex":"Cells are the body’s building blocks.","exZh":"细胞是身体的基本单位。","cat":"nutrition","ref":true},
  {"w":"cell","ipa":"/sel/","pos":"n.","zh":"细胞","say":"One cell is tiny.","sayZh":"单个细胞很小。","ex":"A cell is the smallest unit of life.","exZh":"细胞是生命的最小单位。","cat":"nutrition","ref":true},
  {"w":"liquid","ipa":"/ˈlɪkwɪd/","pos":"n./adj.","zh":"液体","say":"Drink a clear liquid.","sayZh":"喝清淡的液体。","ex":"MCT oil is a liquid fat.","exZh":"MCT 油是液态脂肪。","cat":"nutrition","ref":true},
  {"w":"medicine","ipa":"/ˈmedsn/","pos":"n.","zh":"药；医学","say":"Take the medicine as told.","sayZh":"按医嘱服药。","ex":"Sports medicine handles training injury.","exZh":"运动医学处理训练损伤。","cat":"nutrition","ref":true},
  {"w":"liver","ipa":"/ˈlɪvə/","pos":"n.","zh":"肝脏","say":"The liver handles most metabolism.","sayZh":"肝脏负责大部分代谢。","ex":"MCT oil goes straight to the liver.","exZh":"MCT 油直接进肝脏。","cat":"nutrition","ref":true},
  {"w":"eating","ipa":"/ˈiːtɪŋ/","pos":"n.","zh":"进食；饮食","say":"Eating at maintenance is fine.","sayZh":"吃维持热量就行。","ex":"Eating at maintenance for a while is a fine place to sit.","exZh":"维持热量吃一阵子也挺好。","cat":"daily","ref":true},
  {"w":"stiff","ipa":"/stɪf/","pos":"adj.","zh":"僵硬的","say":"My back feels stiff today.","sayZh":"今天后背发僵。","ex":"A stiff thoracic spine limits the press.","exZh":"胸椎僵硬会限制推举。","cat":"training","ref":true},
  {"w":"worse","ipa":"/wɜːs/","pos":"adj.","zh":"更糟的","say":"Pain got worse this morning.","sayZh":"今早疼痛加重了。","ex":"Achilles pain is worse in the morning.","exZh":"跟腱痛在早晨更明显。","cat":"training","ref":true},
  {"w":"stomach","ipa":"/ˈstʌmək/","pos":"n.","zh":"胃；腹部","say":"My stomach feels full.","sayZh":"肚子感觉很饱。","ex":"Add fibre slowly or your stomach will complain.","exZh":"纤维加太快，胃会抗议。","cat":"daily","ref":true},
  {"w":"rotation","ipa":"/rəʊˈteɪʃn/","pos":"n.","zh":"旋转","say":"Use rotation in the throw.","sayZh":"投掷时用上旋转。","ex":"The thoracic spine is built for rotation.","exZh":"胸椎本就为旋转而生。","cat":"training","ref":true},
  {"w":"action","ipa":"/ˈækʃn/","pos":"n.","zh":"动作；行动","say":"One smooth action, no jerk.","sayZh":"一个流畅动作，别猛拉。","ex":"Coordination is one smooth action.","exZh":"协调就是一组流畅动作。","cat":"training","ref":true},
  {"w":"care","ipa":"/keə/","pos":"n.","zh":"护理；注意","say":"Take care of the shoulder.","sayZh":"照顾好肩膀。","ex":"It is a memory aid for early injury care.","exZh":"它是早期损伤护理的助记法。","cat":"training","ref":true},
  {"w":"improves","ipa":"/ɪmˈpruːvz/","pos":"v.","zh":"改善（三单）","say":"Stretching improves how you move.","sayZh":"拉伸改善你的动作。","ex":"Stretching improves flexibility.","exZh":"拉伸改善柔韧性。","cat":"training","ref":true},
  {"w":"track","ipa":"/træk/","pos":"v.","zh":"追踪","say":"Track your protein each day.","sayZh":"每天记录蛋白质。","ex":"Protein is the macro I track first.","exZh":"蛋白质是我最先盯的宏量营养素。","cat":"training","ref":true},
  {"w":"adapt","ipa":"/əˈdæpt/","pos":"v.","zh":"适应","say":"The body adapts to the load.","sayZh":"身体会适应负荷。","ex":"Tendons adapt slower than muscles.","exZh":"肌腱比肌肉适应得慢。","cat":"training","ref":true},
  {"w":"stable","ipa":"/ˈsteɪbəl/","pos":"adj.","zh":"稳定的","say":"Keep the core stable.","sayZh":"保持核心稳定。","ex":"A shallow socket makes the joint less stable.","exZh":"关节窝浅，关节就不那么稳。","cat":"training","ref":true},
  {"w":"safely","ipa":"/ˈseɪfli/","pos":"adv.","zh":"安全地","say":"Lower the weight safely.","sayZh":"安全地放下重量。","ex":"Move safely within your range.","exZh":"在幅度内安全地动。","cat":"daily","ref":true},
  {"w":"absorb","ipa":"/əbˈzɔːb/","pos":"v.","zh":"吸收","say":"The gut absorbs the nutrients.","sayZh":"肠道吸收营养素。","ex":"Fat helps you absorb vitamins.","exZh":"脂肪帮你吸收维生素。","cat":"nutrition","ref":true},
  {"w":"grams","ipa":"/ɡræmz/","pos":"n.","zh":"克（复数）","say":"Five grams is standard.","sayZh":"五克是常规量。","ex":"Five grams of creatine a day is standard.","exZh":"每天五克肌酸是常规量。","cat":"nutrition","ref":true},
  {"w":"gram","ipa":"/ɡræm/","pos":"n.","zh":"克","say":"One gram per kilo is plenty.","sayZh":"每公斤一克就够。","ex":"A serving is thirty grams.","exZh":"一份是三十克。","cat":"nutrition","ref":true},
  {"w":"sweat","ipa":"/swet/","pos":"n./v.","zh":"汗；出汗","say":"You will sweat a lot today.","sayZh":"今天会出很多汗。","ex":"Water alone is not enough when you sweat heavily.","exZh":"大量出汗时只喝水不够。","cat":"training","ref":true},
  {"w":"fluid","ipa":"/ˈfluːɪd/","pos":"n.","zh":"液体；滑液","say":"Drink fluid between sets.","sayZh":"组间喝点液体。","ex":"A synovial joint has fluid and cartilage.","exZh":"滑液关节里有液体和软骨。","cat":"training","ref":true},
  {"w":"follows","ipa":"/ˈfɒləʊz/","pos":"v.","zh":"跟随（三单）","say":"Pain follows the nerve path.","sayZh":"疼痛沿着神经走向。","ex":"Leg pain that follows a nerve is the usual sign.","exZh":"沿神经走行的腿痛是典型信号。","cat":"training","ref":true},
  {"w":"taste","ipa":"/teɪst/","pos":"v./n.","zh":"味道；尝","say":"Taste the food before you add salt.","sayZh":"加盐前先尝尝。","ex":"Processed food is built to taste good.","exZh":"加工食品被做得好吃。","cat":"nutrition","ref":true},
  {"w":"badly","ipa":"/ˈbædli/","pos":"adv.","zh":"糟糕地","say":"It healed badly last time.","sayZh":"上次愈合得很差。","ex":"Cartilage repairs badly without blood.","exZh":"没有血液，软骨修复得很差。","cat":"training","ref":true},
  {"w":"scale","ipa":"/skeɪl/","pos":"n.","zh":"秤；比例","say":"Weigh on the same scale.","sayZh":"用同一台秤称重。","ex":"Scale weight swings with water and salt.","exZh":"体重随水分和盐波动。","cat":"training","ref":true},
  {"w":"useful","ipa":"/ˈjuːsfəl/","pos":"adj.","zh":"有用的","say":"This cue is useful for beginners.","sayZh":"这个提示对初学者有用。","ex":"It is useful for tendons and control.","exZh":"它对肌腱和控制都有用。","cat":"training","ref":true},
  {"w":"lost","ipa":"/lɒst/","pos":"v.","zh":"丢失（过去式）","say":"I lost a rep on the last set.","sayZh":"最后一组少做了一个。","ex":"Protein lost must be replaced.","exZh":"丢失的蛋白质要补回来。","cat":"training","ref":true},
  {"w":"bottle","ipa":"/ˈbɒtl/","pos":"n.","zh":"瓶子","say":"Bring a water bottle.","sayZh":"带个水瓶。","ex":"Drop a tablet in your bottle on hot days.","exZh":"热天往水瓶里丢一片电解质。","cat":"daily","ref":true},
  {"w":"slower","ipa":"/ˈsləʊə/","pos":"adj.","zh":"更慢的","say":"Take a slower tempo.","sayZh":"放慢节奏。","ex":"A slower tempo makes light weight feel heavy.","exZh":"节奏越慢，轻重量也显得重。","cat":"training","ref":true},
  {"w":"advice","ipa":"/ədˈvaɪs/","pos":"n.","zh":"建议","say":"Take the coach’s advice.","sayZh":"听教练的建议。","ex":"Stand up fast and lower slow — that is the usual advice.","exZh":"快速站起、慢放下，这是通常的建议。","cat":"training","ref":true},
  {"w":"completely","ipa":"/kəmˈpliːtli/","pos":"adv.","zh":"完全地","say":"Rest completely between sets.","sayZh":"组间彻底休息。","ex":"Cutting carbs completely usually backfires.","exZh":"完全砍掉碳水通常会反弹。","cat":"training","ref":true},
  {"w":"attaches","ipa":"/əˈtætʃɪz/","pos":"v.","zh":"附着（三单）","say":"The muscle attaches to the bone.","sayZh":"肌肉附着在骨头上。","ex":"The gluteus medius attaches around it.","exZh":"臀中肌附着在其周围。","cat":"anatomy","ref":true},
  {"w":"wider","ipa":"/ˈwaɪdə/","pos":"adj.","zh":"更宽的","say":"A wider base feels safer.","sayZh":"底盘越宽越稳。","ex":"A wider base makes balance easier.","exZh":"底盘越宽，平衡越容易。","cat":"training","ref":true},
  {"w":"corner","ipa":"/ˈkɔːnə/","pos":"n.","zh":"角落","say":"Protect the inside corner.","sayZh":"保护好内侧角落。","ex":"Losing one corner makes the arch collapse.","exZh":"少一个角，足弓就塌。","cat":"anatomy","ref":true},
  {"w":"shorter","ipa":"/ˈʃɔːtə/","pos":"adj.","zh":"更短的","say":"Take a shorter rest today.","sayZh":"今天休息短一点。","ex":"It is deeper and shorter than the opposite muscle.","exZh":"它比对抗肌更深更短。","cat":"training","ref":true},
  {"w":"pure","ipa":"/pjʊə/","pos":"adj.","zh":"纯粹的","say":"This is pure hip work.","sayZh":"这是纯粹的髋部训练。","ex":"It is a pure hip flexor.","exZh":"它是纯粹的髋屈肌。","cat":"training","ref":true},
  {"w":"lie","ipa":"/laɪ/","pos":"v.","zh":"躺；位于","say":"Lie face down on the bench.","sayZh":"趴在训练凳上。","ex":"You lie face down for the chest-supported row.","exZh":"练支撑划船时你趴着。","cat":"training","ref":true},
  {"w":"burn","ipa":"/bɜːn/","pos":"v./n.","zh":"灼烧（肌肉泵感）","say":"You will feel the burn at the top.","sayZh":"顶端你会感到灼烧感。","ex":"Hold the wall sit until your thighs burn.","exZh":"靠墙静蹲到大腿发烫。","cat":"training","ref":true},
  {"w":"burns","ipa":"/bɜːnz/","pos":"v.","zh":"灼烧（三单）","say":"The last rep burns most.","sayZh":"最后一下最灼烧。","ex":"A deload week cuts what burns you out.","exZh":"减量周削减让你透支的部分。","cat":"training","ref":true},
  {"w":"mixes","ipa":"/ˈmɪksɪz/","pos":"v.","zh":"混合（三单）","say":"The plan mixes lifting with cardio.","sayZh":"计划把力量和有氧混着来。","ex":"It usually mixes lifting with cardio.","exZh":"它通常把力量和有氧混在一起。","cat":"training","ref":true},
  {"w":"angle","ipa":"/ˈæŋɡl/","pos":"n.","zh":"角度","say":"Find the angle your shoulder likes.","sayZh":"找到你肩膀舒服的角度。","ex":"Dumbbells let you find the angle.","exZh":"哑铃让你找到角度。","cat":"training","ref":true},
  {"w":"evenly","ipa":"/ˈiːvənli/","pos":"adv.","zh":"均匀地","say":"Press the weight up evenly.","sayZh":"把重量均匀地推起。","ex":"Load the barbell evenly.","exZh":"杠铃两边重量要均匀。","cat":"training","ref":true},
  {"w":"straightens","ipa":"/ˈstreɪtnz/","pos":"v.","zh":"伸直（三单）","say":"The quad straightens the knee.","sayZh":"股四头伸直膝盖。","ex":"The quadriceps straightens the knee.","exZh":"股四头肌伸直膝关节。","cat":"anatomy","ref":true},
  {"w":"resist","ipa":"/rɪˈzɪst/","pos":"v.","zh":"抵抗","say":"The core resists the twist.","sayZh":"核心抵抗扭转。","ex":"They work together to resist twisting under load.","exZh":"它们协同抵抗负重下的扭转。","cat":"training","ref":true},
  {"w":"pad","ipa":"/pæd/","pos":"n.","zh":"衬垫","say":"Use a pad under the bar.","sayZh":"杠铃下垫个护垫。","ex":"A swollen bursa feels like a soft pad.","exZh":"肿起的滑囊像一块软垫。","cat":"training","ref":true},
  {"w":"includes","ipa":"/ɪnˈkluːdz/","pos":"v.","zh":"包含（三单）","say":"The set includes a warm-up.","sayZh":"这组包含热身。","ex":"The midfoot includes the navicular.","exZh":"中足包含舟骨。","cat":"anatomy","ref":true},
  {"w":"chain","ipa":"/tʃeɪn/","pos":"n.","zh":"链条；链","say":"The kinetic chain starts at the foot.","sayZh":"动力链从脚开始。","ex":"A weak link breaks the chain.","exZh":"一环弱，整条链就断。","cat":"training","ref":true},
  {"w":"within","ipa":"/wɪˈðɪn/","pos":"prep.","zh":"在…之内","say":"Stay within your range.","sayZh":"保持在你的幅度之内。","ex":"Keep the movement within the safe range.","exZh":"把动作控制在安全幅度内。","cat":"training","ref":true},
  {"w":"firm","ipa":"/fɜːm/","pos":"adj.","zh":"紧实的","say":"Keep a firm core.","sayZh":"保持核心紧实。","ex":"A firm surface is better for balance.","exZh":"坚实的平面更利于平衡。","cat":"training","ref":true},
