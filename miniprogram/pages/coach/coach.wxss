.seg { display: flex; gap: 8rpx; margin: 24rpx var(--pad-page) 0; padding: 6rpx; background: #f2f2f3; border-radius: 999rpx; }
.seg-item { flex: 1; text-align: center; font-size: var(--fs-caption); color: var(--ink-4); line-height: 64rpx; border-radius: 999rpx; }
.seg-item.on { background: #fff; color: var(--ink-1); font-weight: 600; }

/* 还没会员时的空态：一句说明 + 一个去「我的」看教练码的入口 */
.member-empty { margin: 24rpx var(--pad-page) 0; padding: 40rpx var(--pad-card); background: #fff; border-radius: 32rpx; text-align: center; font-size: var(--fs-meta); color: var(--ink-4); line-height: 1.7; }
.empty-link { margin-top: 18rpx; font-size: var(--fs-caption); color: var(--ink-2); text-decoration: underline; }

/* 日 / 周 / 月 / 年：总看板四档。日视图是「今天谁还没动」那张快照 */
.period-row { display: flex; align-items: center; gap: 12rpx; padding: 24rpx var(--pad-page) 0; }
.chip { padding: 0 24rpx; line-height: 54rpx; border: 1rpx solid transparent; border-radius: 999rpx; background: #f5f5f6; font-size: var(--fs-caption); color: var(--ink-4); }
.chip-on { background: #fff; border-color: var(--ink-7); color: var(--ink-1); font-weight: 600; }
.period-range { margin-left: auto; font-size: var(--fs-caption); color: var(--ink-5); }
.board-counts { padding: 12rpx var(--pad-page) 0; font-size: var(--fs-micro); color: var(--ink-5); }

/* 总看板两种看法：按项目（默认）/ 按人 */
.seg2 { display: flex; gap: 12rpx; margin: 24rpx var(--pad-page) 0; }
.seg2-item { flex: none; padding: 0 28rpx; line-height: 56rpx; border: 1rpx solid transparent; border-radius: 999rpx; background: #f5f5f6; font-size: var(--fs-caption); color: var(--ink-4); }
.seg2-item.on { background: #fff; border-color: var(--ink-7); color: var(--ink-1); font-weight: 600; }

/* 按项目看：一张卡一个项目，卡里横轴是每一个人（一根柱子一个人，像排行榜） */
.chart-card { margin: 20rpx var(--pad-page) 0; padding: 28rpx 32rpx 24rpx; background: #fff; border-radius: 32rpx; }
.chart-head { display: flex; align-items: baseline; gap: 16rpx; }
.chart-title { font-size: var(--fs-subhead); font-weight: 600; }
.chart-title.bar-weight, .chart-title.bar-waist { color: #32A964; }
.chart-note { flex: 1; font-size: var(--fs-micro); color: var(--ink-5); overflow: hidden; white-space: nowrap; text-overflow: ellipsis; }
.chart-plot { position: relative; flex: 1; min-width: 0; }
/* 100% 达标线（体测卡上这条就是「没变」的中线）。位置由 JS 算成 rpx：
   柱子区 200rpx + 名字区 64rpx，按整张图的百分比算会随名字长短漂。 */
.chart-line { position: absolute; left: 0; right: 0; height: 0; border-top: 1rpx dashed var(--ink-6); z-index: 0; }
/* 体测卡的这条是「没变」的中线，要看得出来 */
.chart-line-zero { border-top: 1rpx solid var(--ink-5); }

/* 纵轴：固定在最左，柱子横滑时不跟着动。三段高度与右边一列一一对齐 */
.chart-body { display: flex; align-items: flex-start; margin-top: 24rpx; }
.chart-y { flex: none; width: 76rpx; box-sizing: border-box; }
.chart-y-spacer { height: 32rpx; }              /* 对齐 .col-top */
.chart-y-track { position: relative; height: 200rpx; } /* 对齐 .col-slot */
.chart-y-foot { height: 64rpx; }                /* 对齐 .col-name + .col-sub */
.chart-y-track::after { content: ''; position: absolute; right: 0; top: 0; bottom: 0; width: 1rpx; background: var(--ink-7); }
.chart-y-item { position: absolute; right: 0; transform: translateY(50%); display: flex; align-items: center; gap: 4rpx; }
.chart-y-k { font-size: var(--fs-micro); color: var(--ink-5); line-height: 1; font-variant-numeric: tabular-nums; }
.chart-y-tick { width: 8rpx; height: 1rpx; background: var(--ink-6); }

.chart-cols { width: 100%; white-space: nowrap; }
.chart-row { display: inline-flex; align-items: flex-end; gap: 24rpx; min-width: 100%; padding: 0 2rpx 0 12rpx; }
.chart-col { flex: 1; min-width: 100rpx; max-width: 150rpx; display: flex; flex-direction: column; }
.col-top { height: 32rpx; }
/* 柱顶数字：绝对定位在柱子区里，跟着 b.h 走 */
.col-val { position: absolute; left: -24rpx; right: -24rpx; text-align: center; font-size: var(--fs-micro); line-height: 24rpx; color: var(--ink-1); font-variant-numeric: tabular-nums; }
.col-muted { color: var(--ink-6); }
/* 柱子区：普通柱从底部长，双向柱以中线为界上下长 */
.col-slot { position: relative; height: 200rpx; }
/* 柱子细一点：28rpx 只剩「一根线」那么细的观感，一眼能数清人数，又不至于挡住旁边的人名 */
.col-bar { position: absolute; left: 50%; transform: translateX(-50%); width: 28rpx; bottom: 0; border-radius: 8rpx 8rpx 0 0; }
.col-bar.bar-cardio { background: #D93B36; }
.col-bar.bar-strength { background: #3D6EDC; }
.col-bar.bar-water { background: #06B6D4; }
.col-bar.bar-up { background: #DF7A77; border-radius: 8rpx 8rpx 0 0; }
.col-bar.bar-down { background: #32A964; border-radius: 0 0 8rpx 8rpx; bottom: auto; }
.col-bar.col-loose { background: var(--ink-7); }
/* 一点没记的人：留一截淡底桩，那一列不至于空成一片 */
.col-stub { height: 8rpx; background: #f0f0f1; border-radius: 8rpx; }
.col-name { margin-top: 12rpx; height: 28rpx; line-height: 28rpx; text-align: center; font-size: var(--fs-caption); color: var(--ink-1); overflow: hidden; white-space: nowrap; text-overflow: ellipsis; }
.col-sub { height: 24rpx; line-height: 24rpx; text-align: center; font-size: var(--fs-micro); color: var(--ink-5); overflow: hidden; white-space: nowrap; text-overflow: ellipsis; }
/* 纵轴是什么、基线在哪：每张卡自己说清楚，不靠图例猜 */
.chart-axis-cap { margin-top: 20rpx; font-size: var(--fs-micro); color: var(--ink-5); line-height: 30rpx; }

/* 按人看：一人一张卡（三条进度条 + 体测变化量） */
/* 三条进度条的颜色就是全站项目色：有氧红 / 抗阻蓝 / 饮水亮青 */
.mcard { margin: 20rpx var(--pad-page) 0; padding: 28rpx 32rpx; background: #fff; border-radius: 32rpx; }
.mcard-head { display: flex; align-items: flex-start; }
.mcard-id { flex: 1; min-width: 0; }
.mcard-name { font-size: var(--fs-subhead); color: var(--ink-1); font-weight: 600; line-height: 44rpx; }
.mcard-sub { margin-top: 4rpx; font-size: var(--fs-micro); color: var(--ink-5); }
.mcard-unlink { flex: none; margin-left: 16rpx; padding: 0 20rpx; line-height: 52rpx; font-size: var(--fs-caption); color: var(--ink-4); border: 1rpx solid var(--ink-7); border-radius: 999rpx; }
/* 备注按钮：和「解除」并排的小胶囊；备注本身是一行浅字，不打扰数据 */
.mcard-remark-btn { flex: none; margin-left: 16rpx; padding: 0 20rpx; line-height: 52rpx; font-size: var(--fs-caption); color: var(--ink-3); background: #f7f7f8; border-radius: 999rpx; }
.mcard-remark { margin-top: 10rpx; font-size: var(--fs-caption); color: var(--ink-4); }

.mrow { display: flex; align-items: center; gap: 20rpx; margin-top: 24rpx; }
.mrow-label { flex: none; width: 68rpx; font-size: var(--fs-caption); color: var(--ink-2); }
.bar-cardio { color: #D93B36; }
.bar-strength { color: #3D6EDC; }
.bar-water { color: #06B6D4; }
.mrow-track { flex: 1; height: 14rpx; border-radius: 999rpx; background: #f2f2f3; overflow: hidden; }
.mrow-fill { height: 100%; border-radius: 999rpx; }
.mrow-fill.bar-cardio { background: #D93B36; }
.mrow-fill.bar-strength { background: #3D6EDC; }
.mrow-fill.bar-water { background: #06B6D4; }
/* 没设目标但记过：一根淡条表示「有记录」，不冒充实测进度 */
.mrow-loose { background: var(--ink-7); }
.mrow-val { flex: none; max-width: 300rpx; text-align: right; font-size: var(--fs-caption); color: var(--ink-2); font-variant-numeric: tabular-nums; overflow: hidden; white-space: nowrap; text-overflow: ellipsis; }
.mrow-empty { color: var(--ink-5); }

.mdelta-row { display: flex; gap: 20rpx; margin-top: 24rpx; padding-top: 24rpx; border-top: 1rpx solid #f4f4f5; }
.mdelta { flex: 1; min-width: 0; }
.mdelta-top { display: flex; align-items: baseline; gap: 12rpx; }
.mdelta-k { font-size: var(--fs-caption); color: var(--ink-4); }
.mdelta-v { font-size: var(--fs-body); color: var(--ink-1); font-weight: 600; font-variant-numeric: tabular-nums; }
.mdelta-sub { margin-top: 4rpx; font-size: var(--fs-micro); color: var(--ink-5); overflow: hidden; white-space: nowrap; text-overflow: ellipsis; }

.board-foot { margin: 20rpx var(--pad-page) 0; font-size: var(--fs-micro); color: var(--ink-6); line-height: 30rpx; }

.member-empty { margin: 24rpx var(--pad-page) 0; padding: 32rpx; background: #fff; border-radius: 32rpx; font-size: var(--fs-body); color: var(--ink-4); line-height: 44rpx; }

/* 训练结构乐高柱（2026-10-30）：一人一行细条，条高 14rpx，一屏能看十来个人 */
.mix-list { margin-top: 20rpx; display: flex; flex-direction: column; gap: 18rpx; }
.mix-row { display: flex; align-items: center; gap: 16rpx; }
.mix-name { width: 120rpx; flex: none; font-size: var(--fs-caption); color: var(--ink-1); overflow: hidden; white-space: nowrap; text-overflow: ellipsis; }
.mix-track { flex: 1; min-width: 0; height: 14rpx; border-radius: 7rpx; background: #f0f0f1; display: flex; overflow: hidden; }
.mix-seg { height: 100%; }
.mix-val { width: 96rpx; flex: none; text-align: right; font-size: var(--fs-micro); color: var(--ink-4); font-variant-numeric: tabular-nums; }
