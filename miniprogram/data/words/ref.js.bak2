  {"w":"formal","ipa":"/ˈfɔːml/","pos":"adj.","zh":"正式的","say":"Use the formal term in writing.","sayZh":"书写时用正式术语。","ex":"It is the formal word behind “joint”.","exZh":"它是“joint”背后的正式叫法。","cat":"anatomy","ref":true},
  {"w":"added","ipa":"/ˈædɪd/","pos":"v.","zh":"增加（过去式）","say":"You added too much too soon.","sayZh":"你加得太快太多。","ex":"Shin splints mean you added too much.","exZh":"小腿骨膜炎意味着你加量过猛。","cat":"training","ref":true},
  {"w":"percent","ipa":"/pəˈsent/","pos":"n.","zh":"百分比","say":"Lift to ninety percent of your max.","sayZh":"用最大重量的九成来练。","ex":"A small deficit is a few percent of intake.","exZh":"小缺口只是摄入的几个百分点。","cat":"training","ref":true},
